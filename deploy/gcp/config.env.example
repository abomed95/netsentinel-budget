# NetSentinel — paramètres du déploiement Google Cloud.
# Copier en config.env (ignoré par git) puis adapter. AUCUN SECRET ICI :
# la clé d'API est générée par setup.sh et stockée dans Secret Manager.

# Projet DÉDIÉ conseillé (données d'un ministère : transférable au client sans toucher au reste).
PROJECT_ID="ton-projet-gcp"
# europe-west1 (Belgique) : tarif le plus bas. Vérifie d'abord les exigences de
# localisation des données du client : c'est une question contractuelle.
REGION="europe-west1"

SERVICE="netsentinel-api"          # service Cloud Run (identique à cloudbuild.yaml)
REPOSITORY="netsentinel"           # dépôt Artifact Registry
SERVICE_ACCOUNT="netsentinel-run"  # compte de service de l'application

# true  : URL publique ; seule la clé X-API-Key protège /predict (le tableau de bord est public).
# false : seuls les comptes Google autorisés (roles/run.invoker) peuvent appeler le service,
#         en plus de la clé. Conseillé pour un usage strictement interne au ministère.
PUBLIC_ACCESS="true"

MIN_INSTANCES="0"   # 0 : gratuit dans le volume offert ; démarrage à froid d'environ 1 s
MAX_INSTANCES="2"   # la limitation de débit est en mémoire : la limite réelle est multipliée par ce nombre
RATE_LIMIT="120"    # requêtes par minute et par adresse
