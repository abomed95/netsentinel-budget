# NetSentinel — variables d'environnement de l'API (toutes facultatives en développement).

# development | production. En production, NETSENTINEL_API_KEY est obligatoire.
NETSENTINEL_ENV=development
# Clé exigée dans l'en-tête X-API-Key des routes /predict, /predict/batch et /departments.
# Génère-la avec : python -c "import secrets; print(secrets.token_urlsafe(32))"
NETSENTINEL_API_KEY=
# Origines web autorisées à appeler l'API (séparées par des virgules). Vide = aucune.
# Exemple : https://tableau-de-bord.exemple.dj
NETSENTINEL_CORS_ORIGINS=
# Taille maximale d'un lot /predict/batch.
NETSENTINEL_MAX_BATCH=100
# Requêtes par minute et par adresse IP (0 = illimité).
NETSENTINEL_RATE_LIMIT=120
# Proxys de confiance devant l'API (1 sur Cloud Run en direct).
NETSENTINEL_TRUSTED_PROXY_HOPS=1
